-func (a *App) handleDebugRect(w http.ResponseWriter, r *http.Request) {
-	cors(w, r)
-	writeJSON(w, map[string]any{
-		"rect":      rectString(findOverlayWindow()),
-		"userMoved": a.userMoved,
-		"visible":   isWindowVisible(findOverlayWindow()),
-	})
