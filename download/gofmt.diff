-		setClickThrough(h, a.clickThrough)
-	}
-	// 启动早期窗口可能尚未就绪，延迟再断言一次尺寸（幂等）
-	go func() {
-		time.Sleep(800 * time.Millisecond)
-		a.placeWindow()
-	}()
-	// 位置/模式看护：识别手动拖动并持久化 + 执行跟随/显隐模式。
-	// 低频轮询（2s）只为记忆位置与模式同步；不做 topmost 强夺 —— 调研 §3.2 明确反对轮询强置顶。
-	go func() {
